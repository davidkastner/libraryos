{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraryos.dev/schemas/collection-registration/v1",
  "title": "LibraryOS external collection registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "path",
    "format",
    "sha256",
    "validated_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {"const": "https://libraryos.dev/schemas/collection-registration/v1"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path": {"type": "string", "minLength": 1},
    "format": {"enum": ["json", "yaml"]},
    "sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
    "validated_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "created_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "updated_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"}
  }
}
