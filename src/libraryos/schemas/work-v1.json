{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraryos.dev/schemas/work/v1",
  "title": "LibraryOS work manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "id", "work", "sources", "derivatives", "created_at", "updated_at"],
  "properties": {
    "schema": {"const": "https://libraryos.dev/schemas/work/v1"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifiers", "title"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "identifiers": {
          "type": "array",
          "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/identifier"}
        },
        "title": {"type": ["string", "null"]},
        "authors": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "family": {"type": "string"},
                  "given": {"type": "string"},
                  "literal": {"type": "string"},
                  "orcid": {"type": "string"}
                },
                "anyOf": [{"required": ["family"]}, {"required": ["literal"]}]
              }
            ]
          }
        },
        "container_title": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]},
        "issued": {"type": ["string", "integer", "null"]},
        "metadata_status": {"enum": ["unresolved", "candidate", "verified", "conflicting"]},
        "metadata_imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "source_sha256", "record_index", "imported_at"],
            "properties": {
              "format": {"enum": ["bibtex", "csl-json", "ris"]},
              "source_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
              "record_index": {"type": "integer", "minimum": 0},
              "imported_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"}
            }
          }
        },
        "metadata_assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "provider", "provider_version", "requested_identifier", "returned_identifiers", "retrieved_at", "data", "source_url", "raw_response_sha256", "warnings", "status"],
            "properties": {
              "id": {"type": "string", "format": "uuid"},
              "provider": {"type": "string", "minLength": 1},
              "provider_version": {"type": "string", "minLength": 1},
              "requested_identifier": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/identifier"},
              "returned_identifiers": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/identifier"}
              },
              "retrieved_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
              "data": {"type": "object"},
              "source_url": {"type": "string", "format": "uri"},
              "raw_response_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
              "warnings": {"type": "array", "items": {"type": "string"}},
              "status": {"enum": ["candidate", "accepted", "rejected", "conflicting"]},
              "conflicts": {
                "type": "array",
                "uniqueItems": true,
                "items": {"enum": ["title", "authors", "container_title", "publisher", "issued"]}
              }
            }
          }
        },
        "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "bytes", "media_type", "role", "version", "access", "identity_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/relativePath"},
          "sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "version": {
            "enum": ["version_of_record", "accepted_manuscript", "preprint", "repository_copy", "unknown"]
          },
          "access": {
            "enum": ["open_access", "public_repository", "institutional", "restricted", "user_provided", "unknown"]
          },
          "license": {"type": ["string", "null"]},
          "license_source": {"type": ["string", "null"]},
          "provider": {"type": ["string", "null"]},
          "canonical_url": {"type": ["string", "null"], "format": "uri"},
          "original_filename": {"type": ["string", "null"]},
          "retrieved_at": {
            "oneOf": [
              {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
              {"type": "null"}
            ]
          },
          "identity_status": {"enum": ["unverified", "verified", "conflicting", "rejected"]},
          "identity_method": {"type": ["string", "null"]},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
        }
      }
    },
    "source_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "provider", "access", "identity_status", "identity_method", "verified_by", "verified_at", "created_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "url": {"type": "string", "format": "uri"},
          "provider": {"type": "string", "minLength": 1},
          "access": {
            "enum": ["open_access", "public_repository", "institutional", "restricted", "user_provided", "unknown"]
          },
          "media_type": {"type": ["string", "null"]},
          "version": {
            "enum": ["version_of_record", "accepted_manuscript", "preprint", "repository_copy", "unknown"]
          },
          "identity_status": {"const": "verified"},
          "identity_method": {"type": "string", "minLength": 1},
          "verified_by": {"type": "string", "minLength": 1},
          "verified_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
          "created_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
          "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
        }
      }
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "bytes", "media_type", "role", "input_sha256", "generator", "generated_at", "quality"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/relativePath"},
          "sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "input_sha256": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"}
          },
          "generator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "configuration_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"}
            }
          },
          "generated_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
          "quality": {"enum": ["ready", "partial", "failed"]},
          "locators": {
            "type": "array",
            "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/locator"}
          },
          "warnings": {"type": "array", "items": {"type": "string"}},
          "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": ["is-version-of", "is-preprint-of", "is-correction-of", "is-retraction-of", "is-supplement-to", "is-dataset-for", "is-commentary-on", "is-translation-of", "is-part-of", "references"]
          },
          "target": {
            "oneOf": [
              {"type": "string", "format": "uuid"},
              {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/identifier"}
            ]
          },
          "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "updated_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
  }
}
