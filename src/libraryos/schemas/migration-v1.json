{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraryos.dev/schemas/migration/v1",
  "title": "LibraryOS schema migration recovery record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "id", "plan_sha256", "status", "created_at", "updated_at", "changes"],
  "properties": {
    "schema": {"const": "https://libraryos.dev/schemas/migration/v1"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "plan_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
    "status": {"enum": ["applying", "applied", "rolled_back", "rollback_required"]},
    "created_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "updated_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before_sha256", "after_sha256", "backup_path"],
        "properties": {
          "path": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/relativePath"},
          "before_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
          "after_sha256": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
          "backup_path": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/relativePath"}
        }
      }
    },
    "error_code": {"type": "string"}
  }
}
