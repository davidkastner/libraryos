{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraryos.dev/schemas/operation-error/v1",
  "title": "LibraryOS operation error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation", "ok", "error"],
  "properties": {
    "contract_version": {"const": 1},
    "operation": {"type": "string", "pattern": "^libraryos\\.[a-z0-9_.-]+$"},
    "ok": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "details": {"type": "object"},
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "command": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
