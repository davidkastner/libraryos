{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraryos.dev/schemas/review/v1",
  "title": "LibraryOS source review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "id", "work_id", "source_sha256", "reviewer", "purpose", "coverage", "completed_at"],
  "properties": {
    "schema": {"const": "https://libraryos.dev/schemas/review/v1"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "work_id": {"type": "string", "format": "uuid"},
    "source_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/sha256"},
      "uniqueItems": true
    },
    "reviewer": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/actor"},
    "purpose": {"type": "string", "minLength": 1},
    "started_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "completed_at": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/timestamp"},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/locator"}
    },
    "observations": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "method": {"type": "string"},
    "supersedes": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "extensions": {"$ref": "https://libraryos.dev/schemas/common/v1#/$defs/extensions"}
  }
}
